{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["src/**/*.ts", "cdk/**/*.ts"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 140
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always",
            "arrowParentheses": "always"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useArrowFunction": "error"
            },
            "style": {
                "noNonNullAssertion": "error",
                "useConst": "error",
                "useTemplate": "error"
            }
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["cdk/constructs/controllers.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noTemplateCurlyInString": "off"
                    }
                }
            }
        }
    ]
}
